{
  "name": "knowledge-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run sync:history",
    "sync:history": "node scripts/sync-history.mjs",
    "update:coverage": "node scripts/update-history-coverage.mjs",
    "check:data": "node scripts/sync-history.mjs --check && node scripts/validate-data.mjs",
    "pretest": "node scripts/sync-history.mjs --check",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "node --test scripts/*.test.mjs",
    "build": "npm run sync:history && npm run check:data && tsc -b && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx --yes wrangler@4.150.0 deploy"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
